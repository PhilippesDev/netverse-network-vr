<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources NuGet du projet.
  Les paquets du SDK Godot sont publiés sur nuget.org. Le dossier local
  `.godot/localnuget` ne sert que de cache de secours pour les environnements
  sans accès à nuget.org : il est ignoré par Git avec le reste de `.godot/`.
-->
<configuration>
  <packageSources>
    <add key="godot-local" value=".godot/localnuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
